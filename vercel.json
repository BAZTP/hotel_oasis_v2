{
	"version": 2,
	"builds": [
		{
			"src": "/api/index.php",
			"use": "vercel-php@0.7.1"
		},
		{
			"src": "/public/**",
			"use": "@vercel/static"
		}
	],
	"routes": [
		{
			"src": "/(css|js)/(.*)",
			"dest": "public/$1/$2"
		},
		{
			"src": "/images/(.*)",
			"dest": "public/images/$1"
		},
		{
			"src": "/fonts/(.*)",
			"dest": "public/fonts/$1"
		},
		{
			"src": "/(.*)",
			"dest": "/api/index.php"
		}
	]
}
